# Copy this file to "a.env" and fill in your own values.
# NEVER upload the real "a.env" (it is in .gitignore so git will skip it).

# ---- AI (only used when the built-in scam library has no confident match) ----
CHAT_PROVIDER=groq
# Get a key at https://console.groq.com/keys (it starts with gsk_)
GROQ_API_KEY=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
# Current model names: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# ---- Team results page (the 10-day test) ----
# Choose a LONG random secret. It opens the "Team results" page. Without it that page is switched off.
ADMIN_KEY=change-me-to-a-long-random-secret

# ---- Where anonymous test data is stored (quiz results, which scenario matched) ----
# DATA_DIR=data

# ---- Fair use for a PUBLIC link: how many AI questions one visitor may ask ----
ASK_PER_MINUTE=15
ASK_PER_DAY=300

# ---- Running on the internet (Render, Railway, ...): set to true so visitors are counted separately ----
TRUST_PROXY=false

# ---- Running on your own computer ----
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your Wi-Fi can open it too.
HOST=127.0.0.1
PORT=5004

# ---- Optional ----
# ACCESS_CODE=          # a shared password for the chat. LEAVE EMPTY for a public link
# SEND_HISTORY=false    # true = the AI can see earlier messages (default: every situation is judged on its own)
# GROQ_JSON_MODE=true   # asks Groq for strict JSON; retried automatically without it if Groq refuses
# SYSTEM_PROMPT=        # replaces the built-in AI instructions (advanced; leave unset to get the source + emoji answers)
# DEBUG_RESPONSES=false
